{
  "_comment": "apsolut-cortex M6+ hook set — full modern wiring for Claude Code >= 2.1.196: async capture hooks, PostToolUseFailure, UserPromptSubmit correction detection, and asyncRewake PreCompact. Older Claude Code ignores the async fields and runs everything sync, as before. Merge into ~/.claude/settings.json via `apsolut-cortex install-hooks`.",
  "SessionStart": [
    {
      "matcher": "",
      "hooks": [{ "type": "command", "command": "apsolut-cortex hook:session-start" }]
    }
  ],
  "UserPromptSubmit": [
    {
      "matcher": "",
      "hooks": [{ "type": "command", "command": "apsolut-cortex hook:user-prompt-submit" }]
    }
  ],
  "PostToolUse": [
    {
      "matcher": "",
      "hooks": [{ "type": "command", "command": "apsolut-cortex hook:post-tool-use", "async": true }]
    }
  ],
  "PostToolUseFailure": [
    {
      "matcher": "",
      "hooks": [{ "type": "command", "command": "apsolut-cortex hook:post-tool-use", "async": true }]
    }
  ],
  "Stop": [
    {
      "matcher": "",
      "hooks": [{ "type": "command", "command": "apsolut-cortex hook:stop", "async": true }]
    }
  ],
  "SessionEnd": [
    {
      "matcher": "",
      "hooks": [{ "type": "command", "command": "apsolut-cortex hook:session-end" }]
    }
  ],
  "PreCompact": [
    {
      "matcher": "",
      "hooks": [{ "type": "command", "command": "apsolut-cortex hook:pre-compact", "timeout": 60, "asyncRewake": true }]
    }
  ]
}
